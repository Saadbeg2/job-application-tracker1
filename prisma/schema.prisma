generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  Applied
  Interview
  Rejected
  Offer
  Withdrawn
}

enum TaskStatus {
  pending
  completed
  ignored
}

enum ReviewItemType {
  new_application
  status_update
  task
  unknown_job_related
}

enum ReviewStatus {
  pending
  approved
  ignored
  not_relevant
}

model Application {
  id             Int               @id @default(autoincrement())
  company        String
  role           String
  dateApplied    DateTime
  status         ApplicationStatus @default(Applied)
  source         String?
  jobLink        String?
  resumeUsed     String?
  notes          String?
  jobDescription String?
  location       String?
  referral       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tasks          Task[]
  reviewItems    ReviewItem[]      @relation("MatchedApplicationReviewItems")
}

model Task {
  id                 Int        @id @default(autoincrement())
  applicationId      Int?
  company            String
  role               String?
  title              String
  status             TaskStatus @default(pending)
  dueDate            DateTime?
  sourceEmailSubject String
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  application        Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

model ReviewItem {
  id                  Int            @id @default(autoincrement())
  type                ReviewItemType
  reviewStatus        ReviewStatus   @default(pending)
  company             String
  role                String?
  suggestedStatus     ApplicationStatus?
  taskTitle           String?
  source              String?
  gmailMessageId      String?
  threadId            String?
  emailSender         String?
  emailSubject        String?
  emailReceivedAt     DateTime?
  confidence          Float?
  matchedApplicationId Int?
  extractedDataJson   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  matchedApplication  Application?   @relation("MatchedApplicationReviewItems", fields: [matchedApplicationId], references: [id], onDelete: SetNull)

  @@index([reviewStatus])
  @@index([type])
  @@index([matchedApplicationId])
  @@index([gmailMessageId])
}

model EmailMetadata {
  id             Int            @id @default(autoincrement())
  gmailMessageId String         @unique
  threadId       String?
  sender         String?
  subject        String?
  receivedAt     DateTime?
  detectedType   ReviewItemType
  confidence     Float?
  createdAt      DateTime       @default(now())
}

model GmailConnection {
  id                   Int      @id @default(autoincrement())
  providerAccountEmail String?
  accessToken          String
  refreshToken         String?
  expiryDate           DateTime?
  grantedScopes        String?
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ScanHistory {
  id                      Int      @id @default(autoincrement())
  scanStartedAt           DateTime
  scanEndedAt             DateTime
  scanWindowStart         DateTime
  scanWindowEnd           DateTime
  resultCount             Int
  createdReviewItemsCount Int
  createdAt               DateTime @default(now())
}

model GoogleSheetSync {
  id                    Int      @id @default(autoincrement())
  spreadsheetId         String
  spreadsheetUrl        String
  applicationsSheetName String   @default("Applications")
  tasksSheetName        String   @default("Tasks")
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
