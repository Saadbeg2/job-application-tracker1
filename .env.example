# Database
DATABASE_URL="<local-sqlite-or-neon-postgres-url>"

# App base URL / callback URL
APP_BASE_URL="<app-base-url>"
GOOGLE_REDIRECT_URI="<app-base-url>/api/gmail/callback"

# Google OAuth / Gmail
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GMAIL_SCAN_DAYS="7"

# Google Sheets
GOOGLE_SHEETS_DEFAULT_TITLE="Job Application Tracker"
GOOGLE_SHEETS_SPREADSHEET_ID="<optional-google-sheet-id>"
GOOGLE_SHEETS_SPREADSHEET_URL="<optional-google-sheet-url>"

# SMTP reporting
EMAIL_PROVIDER="smtp"
SMTP_HOST="<smtp-host>"
SMTP_PORT="<smtp-port>"
SMTP_SECURE="<true-or-false>"
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password-or-app-password>"
REPORT_FROM_EMAIL="<sender-email>"
REPORT_FROM_NAME="Job Application Tracker"

# Analytics / local debugging
ANALYTICS_TODAY_OVERRIDE="<optional-yyyy-mm-dd>"
ANALYTICS_DEBUG="false"

# Future auth / access control placeholders
AUTH_SECRET="<generate-strong-random-secret-when-auth-is-added>"
ALLOWED_ADMIN_EMAILS="<comma-separated-admin-emails>"
